# Coinly 环境变量示例
# 复制本文件为 .env 后修改为自己的值，不要在仓库中提交真实 .env

# MySQL
DB_PASSWORD=your_mysql_password

# Redis（可选，如果 Redis 没设密码则留空）
REDIS_PASSWORD=

# RabbitMQ
MQ_USERNAME=your_rabbitmq_user
MQ_PASSWORD=your_rabbitmq_password

# JWT 签名密钥：生产环境务必使用长随机字符串，可通过以下命令生成：
# openssl rand -base64 64
JWT_SECRET_KEY=your_random_jwt_secret_key_at_least_32_chars
