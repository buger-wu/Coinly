# ============================================================
# Coinly 项目 .gitignore
# ============================================================

# ---- Java 后端编译产物 ----
target/
*.class
*.jar
*.war
*.ear
*.log
hs_err_pid*

# ---- 前端构建产物 ----
node_modules/
dist/
dist-ssr/
*.local

# ---- IDE 配置 ----
.idea/
*.iml
*.ipr
*.iws
.vscode/settings.json
.vscode/launch.json
*.swp
*.swo
*~

# ---- 本地 Maven 配置（含本机绝对路径，不应上传）----
backend-java/.mvn/settings.xml

# ---- 环境变量文件（含敏感信息）----
.env.local
.env.*.local

# ---- 系统文件 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志文件 ----
*.log
logs/

# ---- 临时文件 ----
*.tmp
*.bak
*.cache
