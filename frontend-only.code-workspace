{
  "folders": [
    {
      "name": "Coinly Frontend",
      "path": "frontend-vue"
    }
  ],
  "settings": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "files.exclude": {
      "node_modules": true,
      "dist": true
    }
  },
  "extensions": {
    "recommendations": [
      "Vue.volar",
      "dbaeumer.vscode-eslint",
      "EditorConfig.EditorConfig",
      "oxc.oxc-vscode"
    ]
  }
}